{
  "name": "download-me",
  "version": "1.0.0",
  "description": "CLI tool to download videos from YouTube, TikTok, Facebook, and other platforms via yt-dlp",
  "type": "module",
  "bin": {
    "download-me": "./bin/download-me.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/download-me.js",
    "test": "node --test",
    "setup:linux": "bash scripts/install-deps.sh",
    "build:bundle": "esbuild bin/download-me.js --bundle --platform=node --format=cjs --outfile=dist/download-me.cjs",
    "build:binary": "npm run build:bundle && pkg dist/download-me.cjs --targets node18-linux-x64 --output dist/download-me-linux"
  },
  "pkg": {
    "assets": [],
    "outputPath": "dist"
  },
  "keywords": [
    "video",
    "download",
    "cli",
    "youtube",
    "tiktok",
    "facebook",
    "yt-dlp"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opiobonniky/download-me.git"
  },
  "homepage": "https://github.com/opiobonniky/download-me#readme",
  "bugs": {
    "url": "https://github.com/opiobonniky/download-me/issues"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^12.0.0",
    "conf": "^13.1.0",
    "inquirer": "^9.2.0",
    "youtube-dl-exec": "^3.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.12.0",
    "esbuild": "^0.25.0"
  }
}
