{
  "name": "@opiobonniky/save",
  "version": "1.1.9",
  "description": "CLI tool to download videos from YouTube, TikTok, Facebook, and other platforms via yt-dlp",
  "type": "module",
  "bin": {
    "save": "bin/save.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/save.js",
    "test": "node --test",
    "setup:linux": "bash scripts/install-deps.sh",
    "build:bundle": "esbuild bin/save.js --bundle --platform=node --format=cjs --outfile=dist/save.cjs",
    "build:binary": "npm run build:bundle && pkg dist/save.cjs --targets node18-linux-x64 --output dist/save-linux",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "pkg": {
    "assets": [],
    "outputPath": "dist"
  },
  "keywords": [
    "video",
    "download",
    "cli",
    "youtube",
    "tiktok",
    "facebook",
    "yt-dlp"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opiobonniky/save.git"
  },
  "homepage": "https://github.com/opiobonniky/save#readme",
  "bugs": {
    "url": "https://github.com/opiobonniky/save/issues"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^12.0.0",
    "conf": "^13.1.0",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@yao-pkg/pkg": "6.12.0",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.25.0",
    "ffmpeg-static": "^5.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
